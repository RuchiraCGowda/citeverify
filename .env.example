# =============================================================================
# CiteVerify Frontend Environment Variables (Vercel)
# =============================================================================
# Base URL of your separately hosted FastAPI backend (e.g., on Render).
# Leave empty during local Vite dev to use the /api dev proxy (http://127.0.0.1:8000).
# On Vercel, set this to your Render service URL without a trailing slash:
#   VITE_API_BASE_URL=https://citeverify-api.onrender.com
VITE_API_BASE_URL=""

# =============================================================================
# Optional Local Dev Proxy Target (vite.config.ts only; ignored in production)
# =============================================================================
VITE_DEV_PROXY_TARGET="http://127.0.0.1:8000"

# =============================================================================
# CiteVerify FastAPI Backend Environment Variables (see /backend/.env.example)
# =============================================================================
# DATABASE_URL=postgresql://user:password@host:5432/citeverify
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# No GEMINI_API_KEY or paid AI API key is required.

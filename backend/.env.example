# FastAPI Backend Environment Configuration
# Copy to .env for local development or configure in Render Dashboard

# PostgreSQL connection string from your hosted provider (Neon, Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citeverify

# Comma-separated list of allowed frontend origins (e.g., Vercel production URL + local dev URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional regex for Vercel preview deployment URLs (e.g., https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=

# Maximum uploaded PDF size in megabytes
MAX_UPLOAD_MB=25

# Optional contact email sent in Crossref User-Agent header for polite API pool priority
CROSSREF_MAILTO=

# File persistence mode: "postgres" stores uploaded PDF & figure PNG bytes in PostgreSQL BYTEA
# Set STORAGE_DIR to an absolute path if you also mount a persistent disk on Render
STORAGE_MODE=postgres
STORAGE_DIR=

# External scholarly lookup timeout in seconds
LOOKUP_TIMEOUT_SECONDS=12.0

# Optional Vision-Capable Model for Scientific Figure & Graph Analysis
# Leave blank to mark visual analysis for Human Review (no Gemini API key is required).
# Works with free/open-source OpenAI-compatible vision servers (e.g., Ollama http://localhost:11434/v1)
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30.0
